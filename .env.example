# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# Get your key at https://app.gnani.ai/voice (API keys section of the dashboard).
GNANI_API_KEY=

# Speech-to-text model. Decide on Nov 6 from the pilot (see docs/RUNBOOK.md).
# prisma-v2.5 is the documented default; prisma-v3.0 may need access on your account.
PRISMA_MODEL=prisma-v2.5

# Server
PORT=3000
# Set to 1 to disable all API-spending routes without touching code (restart to apply).
DEMO_DISABLED=0
# Calls per IP per minute, and total calls per day (IST) across everyone.
RATE_LIMIT_PER_MIN=30
DAILY_CAP=100
# Only set when behind a proxy you trust, e.g. x-forwarded-for on Render or Fly.
# Leave empty to use the socket address (safe default).
TRUSTED_IP_HEADER=
